<View>
  <Audio name="audio" value="$audio" />

  <Header value="Bản nháp Whisper" />
  <Text name="draft" value="$whisper_text" />

  <Choices name="quality" toName="audio" choice="single" showInLine="true">
    <Choice value="OK" />
    <Choice value="Khó nghe" />
    <Choice value="Bỏ qua" />
  </Choices>

  <Header value="Bản đúng sau khi nghe lại" />
  <TextArea
    name="transcription"
    toName="audio"
    value="$whisper_text"
    rows="8"
    editable="true"
    maxSubmissions="1"
  />
</View>
