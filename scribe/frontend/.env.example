# Pilot contact channel. Optional — the app ships with baked-in defaults
# (tranth3truong@gmail.com / +84827745579), so the footer link and lead form
# work without any env config. Set these only to override per deployment.
# VITE_LEAD_ENDPOINT posts leads as JSON; without it the form opens a mailto.
VITE_LEAD_ENDPOINT=
VITE_LEAD_EMAIL=tranth3truong@gmail.com
VITE_LEAD_PHONE=+84827745579
# Required on Vercel. Both URLs must use HTTPS and the same HF Space origin.
# Leave empty for local development or when the combined API serves this site.
# Production: https://tranth3truong-carepath-api.hf.space and
# https://tranth3truong-carepath-api.hf.space/phien-dich-y-khoa/
VITE_API_BASE=
VITE_CONSOLE_URL=
